# =============================================================================
# CONFIGURACION DE MYSPEED PARA DOCKER COMPOSE
# =============================================================================
# 1. Copia esta plantilla, sin reemplazarla:
#      Linux/macOS/Git Bash:  cp .env.example .env
#      PowerShell:            Copy-Item .env.example .env
# 2. Edita .env. Compose lo carga automaticamente desde este directorio.
# 3. Valida antes de iniciar: docker compose config
#
# .env SI esta ignorado por Git; .env.example NO contiene secretos y se publica
# como documentacion. No escribas comentarios al final de valores sensibles.
# Si una clave contiene $, # o espacios, usa comillas simples en .env y valida
# el resultado localmente; docker compose config puede mostrar el secreto.

# Nombre logico del proyecto. Prefija contenedor, red y volumen administrados
# por Compose; permite que varios alumnos usen copias aisladas.
COMPOSE_PROJECT_NAME=myspeed-docker

# Imagen local que Compose construye desde el Dockerfile de este repositorio.
MYSPEED_IMAGE=myspeed:local

# Version informativa escrita en las etiquetas OCI durante el build.
APP_VERSION=1.0.9-docker

# Politica Docker: no, always, on-failure o unless-stopped.
MYSPEED_RESTART_POLICY=unless-stopped

# =============================================================================
# RED Y ACCESO EXTERNO
# =============================================================================
# 0.0.0.0 = publicar en todas las interfaces IPv4 del servidor. Es el valor
# solicitado para acceder desde otros equipos. Para limitarlo al propio host,
# cambia a 127.0.0.1. Tambien puedes indicar una IP concreta del servidor.
#
# ATENCION: 0.0.0.0 no configura firewall, NAT/router, IP publica, DNS ni HTTPS.
# MySpeed inicia sin contrasena. Configura la contrasena desde la interfaz y
# aplica las medidas de docs/05-acceso-externo-y-seguridad.md antes de abrirlo a
# redes no confiables. Nunca publiques 5216 directamente en Internet sin capa
# adicional de proteccion.
MYSPEED_BIND_IP=0.0.0.0

# Puertos del HOST. Cambiarlos no cambia los puertos internos 5216/5217.
MYSPEED_HTTP_PORT=5216
MYSPEED_HTTPS_PORT=5217

# =============================================================================
# APLICACION
# =============================================================================
# Zona horaria IANA usada por el contenedor y por la programacion de pruebas.
# Ejemplos: Europe/Madrid, America/Bogota, America/Mexico_City.
TZ=Etc/UTC

# true ejecuta una prueba de velocidad en CADA arranque del proceso.
RUN_TEST_ON_STARTUP=false

# Base de datos. sqlite es autocontenida y persiste en myspeed-data.
# mysql requiere un servidor MySQL accesible y las cuatro variables siguientes.
# La aplicacion no admite DB_PORT; MySQL usa su puerto predeterminado 3306.
DB_TYPE=sqlite
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Solo para demostraciones controladas. true usa storage_preview.db, omite la
# descarga de CLI, desactiva varias escrituras y anula la proteccion por clave.
# No lo uses como modo de produccion ni como medida de seguridad.
PREVIEW_MODE=false
PREVIEW_MESSAGE=
